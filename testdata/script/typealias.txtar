! exec unparam .
cmp stderr stderr.golden
cmp stdout stdout.golden

-- stderr.golden --
-- stdout.golden --
foo.go:9:20: (Alias).bar - s is unused
foo.go:23:17: use - b is unused
foo.go:36:28: aliasErr - result 1 (testdata.tld/foo.ErrAlias) is never used
-- go.mod --
module testdata.tld/foo

go 1.24
-- foo.go --
package foo

type A struct {
	b struct{}
}

type Alias = A

func (a Alias) bar(s string) {
	_ = a.b // Needed for bar to not be considered a dummy implementation
}

type Box[T any] struct {
	V T
}

// A generic type alias parameter passed by value used to make unparam
// panic when asking go/types for the size of an unresolved type parameter.
type GenericAlias[T any] = Box[T]

var DoWork func()

func use[T any](b GenericAlias[T]) {
	DoWork()
}

// TODO: an alias of error should be skipped like error itself;
// aliasErr's second result should not be reported as never used.
type ErrAlias = error

var (
	errSink error
	sink    int
)

func aliasErr(n int) (int, ErrAlias) {
	sink += n
	return n, errSink
}

func test() {
	Alias{}.bar("")
	use[int](GenericAlias[int]{})
	a, _ := aliasErr(1)
	b, _ := aliasErr(2)
	sink = a + b
}
